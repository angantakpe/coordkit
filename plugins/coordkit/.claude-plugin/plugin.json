{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "coordkit",
  "displayName": "coordkit",
  "version": "5.3.2",
  "description": "Multi-host coordination for Claude Code and Codex: a per-repo bus, durable shared ledger, optional authenticated cross-machine relay, and opt-in anti-clobber guard. Warn-only by default. Heartbeats identify their host, so collision and subagent messages distinguish Claude Code, Codex, and CLI instances.",
  "author": {
    "name": "codehornets",
    "email": "codehornets@gmail.com"
  },
  "skills": "./skills/",
  "commands": "./commands/",
  "agents": [
    "./agents/bounded-implementation-worker.md",
    "./agents/context-governor-auditor.md",
    "./agents/coordination-state-debugger.md",
    "./agents/dispatch-coordinator.md",
    "./agents/goal-verifier.md",
    "./agents/host-adapter-engineer.md",
    "./agents/integration-coordinator.md",
    "./agents/ledger-convergence-auditor.md",
    "./agents/transport-reliability-debugger.md",
    "./agents/work-graph-planner.md"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": "./.mcp.json",
  "lspServers": "./.lsp.json",
  "keywords": [
    "coordination",
    "multi-instance",
    "concurrency",
    "bus",
    "ledger",
    "guard",
    "anti-clobber",
    "skills",
    "auto-activation",
    "agents",
    "dev-docs",
    "orchestration",
    "hooks"
  ],
  "license": "MIT"
}
