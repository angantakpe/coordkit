#!/usr/bin/env bash
# cbus — coordkit live command-center monitor.
#
# Thin wrapper around the bus transport's auto-refreshing `watch` view: a
# full-screen, 2s-refresh dashboard of live agents, collisions, the task board
# and recent activity for a repo. Run it in its own terminal pane.
#
# Usage: cbus [repo]      (repo defaults to the current directory)
#
# Resolves the plugin root from $CLAUDE_PLUGIN_ROOT, falling back to its own
# location so it works whether or not the plugin runtime injects the env var or
# puts bin/ on PATH.
set -uo pipefail

ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
BUS="${ROOT}/scripts/claude-bus.sh"

if [ ! -x "$BUS" ]; then
  echo "cbus: bus transport not found or not executable: $BUS" >&2
  exit 127
fi

exec "$BUS" watch "$@"
