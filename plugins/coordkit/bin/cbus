#!/usr/bin/env bash
# cbus — coordkit live command-center monitor.
#
# Thin wrapper around the bus transport's auto-refreshing `watch` view: a
# full-screen, 2s-refresh dashboard of live agents, collisions, the task board
# and recent activity for a repo. Run it in its own terminal pane.
#
# Usage: cbus [repo]      (repo defaults to the current directory)
#
# Resolves the plugin root from $COORDKIT_PLUGIN_ROOT / host aliases, falling back to its own
# location so it works whether or not the plugin runtime injects the env var or
# puts bin/ on PATH.
set -uo pipefail

# Bootstrap: locate common.sh from this script's real path (readlink -f, with a
# fallback, so a symlinked entrypoint resolves from the actual file, not the
# link). This is the irreducible minimum — the plugin-root env chain itself
# lives in common.sh's ck_runtime_root() and must not be re-spelled here.
__self="$(readlink -f "$0" 2>/dev/null)"; [ -n "$__self" ] || __self="$0"
__common="$(cd "$(dirname "$__self")/../scripts" 2>/dev/null && pwd)/common.sh"
if [ ! -f "$__common" ]; then
  echo "cbus: coordkit runtime not found: $__common" >&2
  exit 127
fi
# shellcheck source=../scripts/common.sh
. "$__common"

ROOT="$(ck_runtime_root)"
BUS="${ROOT}/scripts/bus.sh"

if [ ! -x "$BUS" ]; then
  echo "cbus: bus transport not found or not executable: $BUS" >&2
  exit 127
fi

exec "$BUS" watch "$@"
