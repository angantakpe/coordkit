#!/usr/bin/env python3
import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path


def git_root(start: Path) -> Path:
    try:
        out = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=start,
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip()
        if out:
            return Path(out)
    except Exception:
        pass
    return start


def count_json_files(path: Path) -> int:
    if not path.is_dir():
        return 0
    return sum(1 for item in path.iterdir() if item.is_file() and item.suffix == ".json")


def count_messages(path: Path) -> int:
    if not path.is_dir():
        return 0
    total = 0
    for item in path.iterdir():
        if item.is_dir():
            total += sum(1 for msg in item.iterdir() if msg.is_file() and msg.suffix == ".msg")
    return total


def snapshot(root: Path) -> str:
    bus = root / ".coordkit-bus"
    agents = count_json_files(bus / "agents")
    claims = count_json_files(bus / "claims")
    inbox = count_messages(bus / "inbox")
    branch = ""
    try:
        branch = subprocess.check_output(
            ["git", "branch", "--show-current"],
            cwd=root,
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip()
    except Exception:
        branch = ""
    data = {
        "agents": agents,
        "claims": claims,
        "inbox": inbox,
        "branch": branch,
    }
    return json.dumps(data, sort_keys=True)


def cache_path(plugin_data: Path, root: Path) -> Path:
    digest = hashlib.sha1(str(root).encode("utf-8")).hexdigest()
    return plugin_data / "monitor-state" / f"{digest}.json"


def load_previous(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8").strip()
    except Exception:
        return ""


def save_previous(path: Path, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(value + "\n", encoding="utf-8")


def render(state_json: str) -> str:
    data = json.loads(state_json)
    pieces = [f"CoordKit: {data['agents']} live"]
    pieces.append(f"{data['claims']} claims")
    if data.get("inbox"):
        pieces.append(f"{data['inbox']} inbox")
    if data.get("branch"):
        pieces.append(data["branch"])
    return " · ".join(pieces)


def main() -> int:
    start = Path(os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    root = git_root(start)
    bus = root / ".coordkit-bus"
    plugin_data = Path(os.environ.get("CLAUDE_PLUGIN_DATA") or (root / ".coordkit-plugin-data"))
    cache = cache_path(plugin_data, root)

    last = load_previous(cache)
    while True:
        if not bus.exists():
            time.sleep(60)
            continue
        current = snapshot(root)
        if current != last:
            last = current
            save_previous(cache, current)
            print(render(current), flush=True)
        time.sleep(30)


if __name__ == "__main__":
    raise SystemExit(main())
