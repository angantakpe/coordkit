#!/usr/bin/env bash
# cobus — coordkit shared-context ledger CLI.
#
# Forwards verbs to the ledger transport (the same verbs as the /led command),
# so the cross-instance ledger is drivable from a plain shell as well as from
# inside Claude.
#
# Usage: cobus <verb> [args...]
#
# Resolves the plugin root from $COORDKIT_PLUGIN_ROOT / host aliases, falling back to its own
# location so it works whether or not the plugin runtime injects the env var or
# puts bin/ on PATH.
set -uo pipefail

# Bootstrap: locate common.sh from this script's real path (readlink -f, with a
# fallback, so a symlinked entrypoint resolves from the actual file, not the
# link). This is the irreducible minimum — the plugin-root env chain itself
# lives in common.sh's ck_runtime_root() and must not be re-spelled here.
__self="$(readlink -f "$0" 2>/dev/null)"; [ -n "$__self" ] || __self="$0"
__common="$(cd "$(dirname "$__self")/../scripts" 2>/dev/null && pwd)/common.sh"
if [ ! -f "$__common" ]; then
  echo "cobus: coordkit runtime not found: $__common" >&2
  exit 127
fi
# shellcheck source=../scripts/common.sh
. "$__common"

ROOT="$(ck_runtime_root)"
LEDGER="${ROOT}/scripts/ledger.sh"

usage() {
  cat <<'EOF'
cobus — coordkit shared-context ledger CLI

Usage: cobus <verb> [args...]

Verbs:
  fleet                       cross-repo view: which OTHER repos have live
                              coordkit sessions right now (local-only, never
                              shared — see docs/BUS.md §9)
  heartbeat [--task <id>] [--cap k=v]... [--ttl <s>] [--loop <s>]
                              emit a machine-presence heartbeat into the shared
                              log; --loop re-emits forever (docs/PRESENCE.md)
  peers [--json] [--all]      who is alive on which machine (projection over
                              heartbeat events, works in every transport mode)
  watch [--since 10m|all] [--filter <type,..>] [--json]
                              live tail of the shared event stream across
                              machines (relay long-poll / git sync / local)
  board                       show the projected task queue
  digest | catchup            full shared-context digest
  msg <all|sid8|branch:name> "<text>"
                              deliver a message to matching live instances
  note "<text>"               drop a durable note for all instances
  decide <subject> "<text>"   record a decision (latest per subject wins)
  ask <subject> "<q>"         open a question thread
  answer <subject> "<a>"      answer / close a question thread
  task "<desc>"               queue work (add 'dep:<subject>' to order it)
  next                        auto-claim the first open task whose deps are met
  claim <subject>             lease a task
  done <subject>              mark a task complete
  block <subject> "<why>"     mark a task blocked

Setup / transport:
  init-git [room] [remote]    enable git-mode sharing for this repo
  init-relay <url> [room]     configure an authenticated relay pointer (no token)
  sync                        replicate the git-mode log (run on a timer, not a hook)
  relay-status                show relay endpoint, room, backing, replay cursor,
                              pending outbox count, and auth presence
  relay-sync                  flush the durable outbox and pull replayable events
  migrate                     append the v2 schema-upgrade marker (append-only)
  gc [--apply] [repo]         garbage-collect this repo's .coordkit-bus/ (dead
                              agents/claims/cursors, oversized activity.log).
                              Dry-run by default; --apply to delete. Add
                              --nuke --yes-i-am-sure to remove the bus entirely.
  swarm <N>                   spawn N (1-8) worker loops draining the task
                              queue via next/done/block. Dry-run by default;
                              COORDKIT_SWARM_EXEC=1 + COORDKIT_SWARM_CMD opts
                              into really executing tasks. `cobus swarm --help`
                              for the full contract.
  agents <command>            validate, list, route, render, or compile the
                              bundled Markdown subagent definitions. Run
                              `cobus agents --help` for the runtime contract.
  dispatch <task|"title"> [--to <machine[/actor]>] [--needs k=v,..] [--lease s]
                              hand a task to another machine (cross-machine
                              dispatch with lease/expiry/handoff). Sub-verbs:
                              accept [--auto] | renew | release | done | reap |
                              ls | worker [--exec cmd] | peers | whoami.
                              `cobus dispatch --help` for the full contract.

Linear bridge (docs/LINEAR.md):
  linear pull [--state ..] [--assignee me]
                              Linear issues → ledger tasks (linear-<id>), idempotent
  linear push [ID..|--all]    ledger claims/notes/blocks/done → ONE persistent
                              `coordkit ledger` comment per issue + state/label
  linear sync [--loop <s>]    pull then push; --loop = foreground daemon
  linear link <task> <ID>     map an existing ledger task onto a Linear issue
  linear status               mapping table, last sync, auth presence
                              (add --dry-run to print mutations instead of sending;
                              LINEAR_API_KEY comes from the env, never coord.toml)

  logseq <export|import|sync|status>
                              Logseq ⇄ ledger bridge: project fleet/tasks pages
                              + a journal log into a Logseq graph, and pull
                              #coordkit TODOs back in as ledger tasks
                              (docs/LOGSEQ.md; `cobus logseq --help`).

Read-only projections (machine-readable):
  board --json                task queue as JSON (same projection as `board`)
  events [--since N]          raw ledger events after seq N (logstore-aware)
EOF
}

case "${1:-}" in
  ""|-h|--help|help) usage; exit 0 ;;
esac

# Setup/transport verbs route to their own scripts (not the ledger dispatch).
case "${1:-}" in
  init-git) shift; exec bash "${ROOT}/scripts/init-git.sh" "$@" ;;
  init-relay) shift; exec bash "${ROOT}/scripts/init-relay.sh" "$@" ;;
  sync)     shift; exec bash "${ROOT}/bin/sync.sh" "$@" ;;
  relay-status) shift; exec bash "${ROOT}/scripts/relay-client.sh" status "$@" ;;
  relay-sync)   shift; exec bash "${ROOT}/scripts/relay-client.sh" sync "$@" ;;
  migrate)  shift; exec bash "${ROOT}/scripts/migrate.sh" "$@" ;;
  gc)       shift; exec bash "${ROOT}/scripts/gc.sh" "$@" ;;
  fleet)    shift; exec bash "${ROOT}/scripts/bus.sh" fleet "$@" ;;
  msg)      shift; exec bash "${ROOT}/scripts/bus.sh" msg "$@" ;;
  heartbeat|peers|watch) exec bash "${ROOT}/scripts/presence.sh" "$@" ;;
  swarm)    shift; exec bash "${ROOT}/scripts/worker-runtime.sh" "$@" ;;
  agents)   shift; exec python3 "${ROOT}/scripts/agent-runtime.py" "$@" ;;
  dispatch) shift; exec bash "${ROOT}/scripts/dispatch.sh" "$@" ;;
  linear)   shift; exec bash "${ROOT}/scripts/linear.sh" "$@" ;;
  logseq)   shift; exec bash "${ROOT}/scripts/logseq.sh" "$@" ;;
esac

if [ ! -x "$LEDGER" ]; then
  echo "cobus: ledger transport not found or not executable: $LEDGER" >&2
  exit 127
fi

exec "$LEDGER" "$@"
