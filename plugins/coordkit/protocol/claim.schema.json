{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coordkit/schema/claim/1.0",
  "title": "coordkit claim envelope",
  "description": "Logical claim over a file or task scope. The current implementation represents file claims in the bus and task claims in ledger projections; this schema names the shared concept.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "kind", "target", "owner", "state"],
  "properties": {
    "id": { "type": "string", "description": "Claim id." },
    "kind": {
      "type": "string",
      "enum": ["file", "task"],
      "description": "What the claim protects."
    },
    "target": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["path", "subject"],
          "description": "Target selector type."
        },
        "value": {
          "type": "string",
          "description": "Path or task subject claimed by the owner."
        }
      }
    },
    "owner": {
      "type": "object",
      "required": ["sid"],
      "properties": {
        "sid": { "type": "string", "description": "Owning session id." },
        "sid8": { "type": "string", "description": "Short owner display id." },
        "host": { "type": "string", "description": "Owning host adapter identity." }
      }
    },
    "state": {
      "type": "string",
      "enum": ["active", "released", "expired"],
      "description": "Current claim state."
    },
    "created_at": { "type": "string", "description": "ISO timestamp when the claim was created." },
    "expires_at": { "type": "string", "description": "ISO timestamp when the claim stops being valid." }
  }
}
